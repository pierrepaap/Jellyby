# Jellyby on Rockchip (Radxa ZERO 3): let the kiosk user (group video) reach
# the MPP decoder, the RGA scaler and the DMA heaps that mpv/ffmpeg-rockchip
# use for hardware decode. Harmless if a node does not exist.
KERNEL=="mpp_service", MODE="0660", GROUP="video"
KERNEL=="rga", MODE="0660", GROUP="video"
SUBSYSTEM=="dma_heap", MODE="0660", GROUP="video"
KERNEL=="cec[0-9]*", MODE="0660", GROUP="video"
