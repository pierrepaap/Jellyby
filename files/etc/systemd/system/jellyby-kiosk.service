[Unit]
Description=Jellyby kiosk browser
Wants=jellyby-x.service jellyby-web.service
After=jellyby-x.service jellyby-web.service

[Service]
Type=simple
User=media
Group=media
Environment=DISPLAY=:0
Environment=HOME=/home/media
# (%U would be root's UID in a system unit, not media's: use our own dir)
Environment=XDG_RUNTIME_DIR=/run/jellyby-kiosk
RuntimeDirectory=jellyby-kiosk
RuntimeDirectoryMode=0700
ExecStart=/opt/jellyby/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
